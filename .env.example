# ============================================================
#  TOLARAM YOUTUBE AGENT — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── YouTube Data API v3 ─────────────────────────────────────
# Get your key at: https://console.cloud.google.com/apis/credentials
API_KEY=YOUR_YOUTUBE_API_KEY_HERE
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# ── Google Gemini AI ────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Tolaram YouTube Channel IDs ─────────────────────────────
# Each must start with "UC". Comment out channels you haven't set up yet.
CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
# CHANNEL_INDOMIE=UCxxxxxxxxxxxxxxxxxxxxxxxx
# CHANNEL_DANO=UCxxxxxxxxxxxxxxxxxxxxxxxx
# CHANNEL_HYPO=UCxxxxxxxxxxxxxxxxxxxxxxxx
# CHANNEL_POWER_OIL=UCxxxxxxxxxxxxxxxxxxxxxxxx

# ── Agent Behaviour ─────────────────────────────────────────
VIDEOS_PER_CHANNEL=5
COMMENTS_PER_VIDEO=50
AUTO_REPLY_ENABLED=false

# Crisis keywords (comma-separated, no spaces)
CRISIS_KEYWORDS=reaction,sick,hospital,poison,hurt,injury,death,died,allergic,lawsuit,dangerous

# ── Scheduler ───────────────────────────────────────────────
# How often the agent runs automatically (in hours)
AGENT_INTERVAL_HOURS=2

# ── Dashboard ───────────────────────────────────────────────
DASHBOARD_PORT=5050

# ── Security ────────────────────────────────────────────────
# Optional: Set to restrict /api/trigger-run endpoint
# AGENT_API_SECRET=your_strong_secret_here

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
